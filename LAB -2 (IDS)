GOAL = (1, 2, 3, 4, 5, 6, 7, 8, 0)

def get_neighbors(state):
    """Finds all valid next moves by shifting the empty space (0)."""
    neighbors = []
    idx = state.index(0)
    r, c = divmod(idx, 3) 
    
    moves = {'Up': -3, 'Down': 3, 'Left': -1, 'Right': 1}
    
    for move, shift in moves.items():
        nr, nc = r + (-1 if move == 'Up' else 1 if move == 'Down' else 0), \
                 c + (-1 if move == 'Left' else 1 if move == 'Right' else 0)
        
        if 0 <= nr < 3 and 0 <= nc < 3:
            lst = list(state)
            lst[idx], lst[idx + shift] = lst[idx + shift], lst[idx] 
            neighbors.append((tuple(lst), move))
    return neighbors

def dls(state, depth, visited, path):
    """Depth-Limited Search helper function for IDS."""
    if state == GOAL: 
        return path
    if depth <= 0: 
        return None
    
    visited.add(state)
    for neighbor, move in get_neighbors(state):
        if neighbor not in visited:
           
            result = dls(neighbor, depth - 1, visited.copy(), path + [move])
            if result: 
                return result
    return None

def ids(start_state, max_depth=50):
    """Solves the 8-puzzle using Iterative Deepening Search."""
    for depth in range(max_depth):
        result = dls(start_state, depth, set(), [])
        if result is not None:
            return result
    return None

initial_state = (1, 2, 3, 4, 0, 6, 7, 5, 8) 
print("--- IDS Solver ---")
print("Path to Goal:", ids(initial_state))



