import heapq

GOAL_STATE = (1, 2, 3, 4, 5, 6, 7, 8, 0)

def h_manhattan(state):

    distance = 0
    for i in range(9):
        val = state[i]
        if val != 0:
  
            goal_idx = GOAL_STATE.index(val)
            
    
            curr_row, curr_col = i // 3, i % 3
            goal_row, goal_col = goal_idx // 3, goal_idx % 3
            
         
            distance += abs(curr_row - goal_row) + abs(curr_col - goal_col)
    return distance

def get_neighbors(state):
  
    neighbors = []
    idx = state.index(0)
    row, col = idx // 3, idx % 3
    
    moves = []
    if row > 0: moves.append(-3) 
    if row < 2: moves.append(3)   
    if col > 0: moves.append(-1) 
    if col < 2: moves.append(1)  
    
    for move in moves:
        new_idx = idx + move
        new_state = list(state)
        new_state[idx], new_state[new_idx] = new_state[new_idx], new_state[idx]
        neighbors.append(tuple(new_state))
        
    return neighbors

def a_star_manhattan(start_state):
    open_set = []
    heapq.heappush(open_set, (h_manhattan(start_state), 0, start_state, [start_state]))
    
    visited = set()
    
    while open_set:
        f, g, current, path = heapq.heappop(open_set)
        
        if current == GOAL_STATE:
            return path, g
            
        if current in visited:
            continue
        visited.add(current)
        
        for neighbor in get_neighbors(current):
            if neighbor not in visited:
                new_g = g + 1  
                new_h = h_manhattan(neighbor)
                new_f = new_g + new_h
                heapq.heappush(open_set, (new_f, new_g, neighbor, path + [neighbor]))
                
    return None, -1

def print_puzzle(state):
    for i in range(0, 9, 3):
        print(list(state[i:i+3]))
    print()


if __name__ == "__main__":
    initial_state = (1, 2, 3, 0, 4, 6, 7, 5, 8) 
    
    print("--- CASE 2: MANHATTAN DISTANCE ---")
    print("Initial State:")
    print_puzzle(initial_state)
    
    path, moves = a_star_manhattan(initial_state)
    print(f"Goal reached in {moves} moves!\n")
    
    print("Step-by-step path:")
    for step, state in enumerate(path):
        print(f"Step {step}:")
        print_puzzle(state)
